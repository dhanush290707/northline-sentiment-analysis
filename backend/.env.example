# Copy to backend/.env. Never commit the filled-in file.
# Credentials come from the environment (aws configure, or the Learner Lab
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and AWS_SESSION_TOKEN). Do not
# paste keys into this file.

AWS_REGION=us-east-1
TABLE_NAME=
USER_POOL_ID=
USER_POOL_CLIENT_ID=
NEGATIVE_ESCALATION_THRESHOLD=0.75
ALLOWED_ORIGIN=http://localhost:5173
PORT=3001

# Used only by npm run seed. Leave blank to skip admin creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
